# Google Sheets credentials for the serverless API only.
GOOGLE_SERVICE_ACCOUNT_EMAIL=pos-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=replace-with-spreadsheet-id

# Google OAuth access control. AUTH_SECRET must be a unique random value.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
AUTH_SECRET=generate-with-openssl-rand-base64-32
ALLOWED_EMAILS=arief0303@gmail.com
# Required for Vercel. For local development the request origin is used instead.
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
